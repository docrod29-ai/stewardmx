rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════
    //  HELPERS GLOBALES
    //  Toda validación de rol/status se hace server-side
    //  contra Firestore — NUNCA contra datos del cliente.
    // ══════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    // Super-admin verificado por Firebase Auth custom claim
    // (el email viene en el token y no puede ser manipulado desde el cliente)
    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'docrod29@gmail.com';
    }
    // Staff de plataforma activo (Manager o Contador)
    function isActivePlatformStaff() {
      return isAuth()
        && exists(/databases/$(database)/documents/platform_staff/$(uid()))
        && get(/databases/$(database)/documents/platform_staff/$(uid())).data.activo == true;
    }
    // Manager de plataforma
    function isPlatformManager() {
      return isAuth()
        && exists(/databases/$(database)/documents/platform_staff/$(uid()))
        && get(/databases/$(database)/documents/platform_staff/$(uid())).data.activo == true
        && get(/databases/$(database)/documents/platform_staff/$(uid())).data.rol == 'Manager';
    }
    // Miembro aprobado del hospital (status aprobado o admin)
    function isHospMember(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.status
           in ['aprobado', 'admin'];
    }
    // Administrador del hospital (status admin)
    function isHospAdmin(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.status
           == 'admin';
    }
    // Líder PROA activo
    function isHospLider(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.status == 'aprobado'
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.rol == 'Líder PROA';
    }
    // Rol PROA/Infectología (acceso clínico total)
    function isHospPROA(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.rol
           in ['PROA', 'Infectología', 'Infectólogo', 'Líder PROA', 'Médico PROA'];
    }
    // Farmacéutico del hospital (incluye Auxiliar Farmacia)
    function isHospFarmacia(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.rol
           in ['Farmacéutico', 'Auxiliar Farmacia'];
    }
    // Solo Farmacéutico titular (no Auxiliar) — para escritura de datos clínicos
    function isHospFarmaceuticoTitular(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.rol
           == 'Farmacéutico';
    }
    // Médico (cualquier rol médico)
    function isHospMedico(hospId) {
      return isAuth()
        && exists(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid()))
        && get(/databases/$(database)/documents/hospitals/$(hospId)/users/$(uid())).data.rol
           in ['Medico', 'medico', 'Residente', 'Interno', 'Especialista',
               'Médico adscrito', 'Médico PROA', 'Médico interconsultante',
               'Médico General / Urgencias'];
    }

    // ══════════════════════════════════════════════════════
    //  _audit_log — Registro de auditoría INMUTABLE
    //  create: cualquier usuario autenticado (desde PWA)
    //  read/update/delete: NUNCA desde cliente
    // ══════════════════════════════════════════════════════
    match /_audit_log/{logId} {
      allow create: if isAuth();
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════
    //  users/{uid} — Mapeo uid → hospitalId
    // ══════════════════════════════════════════════════════
    match /users/{userId} {
      allow read:  if isAuth() && (uid() == userId || isSuperAdmin());
      allow write: if isAuth() && uid() == userId;
    }

    // ══════════════════════════════════════════════════════
    //  hospitals_registry — Directorio de hospitales
    // ══════════════════════════════════════════════════════
    match /hospitals_registry/{hospId} {
      allow get:    if isAuth();
      allow list:   if isSuperAdmin() || isActivePlatformStaff();
      allow create: if isAuth();
      allow update: if isSuperAdmin()
                    || (isAuth() && resource.data.adminUid == uid())
                    || isActivePlatformStaff();
      allow delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    //  platform_invites / platform_staff
    // ══════════════════════════════════════════════════════
    match /platform_invites/{email} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }
    match /platform_staff/{staffUid} {
      allow read:  if isAuth() && (uid() == staffUid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    //  hospital_role_codes — Códigos de invitación
    // ══════════════════════════════════════════════════════
    match /hospital_role_codes/{code} {
      allow get:    if isAuth();
      allow list:   if isSuperAdmin();
      allow create: if isSuperAdmin()
                    || (isAuth() && isHospAdmin(request.resource.data.hospitalId))
                    || (isAuth() && isHospLider(request.resource.data.hospitalId));
      allow delete: if isSuperAdmin()
                    || (isAuth() && isHospAdmin(resource.data.hospitalId))
                    || (isAuth() && isHospLider(resource.data.hospitalId));
    }

    // ══════════════════════════════════════════════════════
    //  config/{docId} — CONFIGURACIÓN GLOBAL DE PLATAFORMA
    //  ⚠ SEGURIDAD CRÍTICA: este documento puede contener
    //  la Anthropic API key y otras credenciales.
    //  Lectura: SOLO super-admin (nunca miembros normales)
    //  Escritura: SOLO super-admin
    //  Nota: los usuarios normales usan el proxy Cloud Function
    //  (anthropicProxy) que NO expone la key al cliente.
    // ══════════════════════════════════════════════════════
    match /config/{docId} {
      allow read:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    //  hospitals/{hospId}/** — AISLAMIENTO POR HOSPITAL
    //  Toda regla dentro de este bloque requiere que el
    //  usuario sea miembro del MISMO hospital (hospId).
    //  Un usuario de Hospital A NO puede leer Hospital B.
    // ══════════════════════════════════════════════════════
    match /hospitals/{hospId} {

      // ── Info y configuración del hospital ───────────────
      match /info/{docId} {
        allow get:            if isAuth();
        allow list:           if isSuperAdmin() || isHospMember(hospId);
        allow create:         if isAuth();
        allow update, delete: if isSuperAdmin() || isHospAdmin(hospId) || isHospLider(hospId);
      }
      // config del hospital: solo admin lo escribe; miembros pueden leer
      // (contiene configuración no-sensible: nombre, camas, WA, etc.)
      match /config/{docId} {
        allow read:           if isSuperAdmin() || isHospAdmin(hospId);
        allow create:         if isAuth();
        allow update, delete: if isSuperAdmin() || isHospAdmin(hospId) || isHospLider(hospId);
      }

      // ── Gestión de usuarios del hospital ────────────────
      match /users/{userId} {
        allow read:   if isAuth() && (uid() == userId || isHospAdmin(hospId) || isHospLider(hospId) || isSuperAdmin());
        allow create: if isAuth() && uid() == userId;
        allow update: if isSuperAdmin()
                      || (isHospAdmin(hospId)
                          && userId != uid()
                          && resource.data.status != 'admin'
                          && request.resource.data.status != 'admin')
                      || (isHospLider(hospId)
                          && userId != uid()
                          && resource.data.status != 'admin'
                          && request.resource.data.status != 'admin')
                      // NOTA DE SEGURIDAD (hallazgo CI v294): hoy un usuario puede escribir su
                      // propio 'rol'/'status' — la app lo NECESITA para el alta por código
                      // (_unirseConCodigo). Esto es un vector de escalada porque el código se
                      // valida en cliente. FIX CORRECTO PENDIENTE: validar el código en una Cloud
                      // Function (servidor) que asigne el rol, y entonces bloquear aquí el cambio
                      // de rol/status con diff().affectedKeys(). NO bloquear antes de eso (rompe el alta).
                      || (isAuth() && uid() == userId
                          && request.resource.data.status == resource.data.status
                          && request.resource.data.rol == resource.data.rol);
        allow delete: if isSuperAdmin()
                      || (isHospAdmin(hospId) && userId != uid() && resource.data.status != 'admin')
                      || (isHospLider(hospId) && userId != uid() && resource.data.status != 'admin');
      }

      // ── Censo clínico mensual ────────────────────────────
      // read: cualquier miembro (necesario para trabajo clínico diario)
      // write: cualquier miembro (médicos, PROA, enfermería actualizan)
      match /months/{month}/patients/{patId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin() || isHospMember(hospId);
        // delete solo admin o PROA (no se debe borrar pacientes sin trazabilidad)
        allow delete: if isSuperAdmin() || isHospAdmin(hospId) || isHospPROA(hospId);
      }
      // Historial de auditoría mensual — inmutable desde cliente excepto crear
      match /months/{month}/history/{histId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      // ── Registro permanente de pacientes ────────────────
      match /patients/{patId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin() || isHospMember(hospId);
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }
      match /patients/{patId}/{subCol}/{subDocId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin()
                      || (isHospMember(hospId) && !resource.data.get('firmado', false));
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }

      // ── Laboratorios clínicos ────────────────────────────
      match /patients/{patId}/labs/{labId} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }

      // ── Sistema de Farmacia: Solicitudes de ATBs ────────
      match /antibiotic_requests/{reqId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin() || isHospMember(hospId);
        allow delete: if isSuperAdmin() || isHospAdmin(hospId) || isHospPROA(hospId);
      }
      // Subcollection: Recomendaciones de Farmacia Clínica (FC)
      // write: farmacéuticos y admin
      // read: todos los miembros (PROA necesita ver las recomendaciones)
      match /antibiotic_requests/{reqId}/fc_recomendaciones/{recoId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospAdmin(hospId) || isHospFarmaceuticoTitular(hospId);
        allow update: if isSuperAdmin() || isHospAdmin(hospId) || isHospFarmaceuticoTitular(hospId);
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }

      // ── Catálogo de antibióticos ─────────────────────────
      match /antibiotics_catalog/{catId} {
        allow read:  if isSuperAdmin() || isHospMember(hospId);
        allow write: if isSuperAdmin() || isHospAdmin(hospId);
      }

      // ── Bloqueos de ATBs ─────────────────────────────────
      // write: PROA, Farmacéutico, Admin
      // read: todos los miembros (enfermería y médicos necesitan saber)
      match /atb_blocks/{blockId} {
        allow read:  if isSuperAdmin() || isHospMember(hospId);
        allow write: if isSuperAdmin() || isHospAdmin(hospId)
                     || isHospPROA(hospId) || isHospFarmacia(hospId);
      }

      // ── DDD Farmacia — Consumo diario real ───────────────
      // write: SOLO farmacéutico titular o admin (dato oficial)
      // read: todos los miembros con acceso al hospital
      match /ddd_farmacia/{docId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospAdmin(hospId) || isHospFarmaceuticoTitular(hospId);
        allow update: if isSuperAdmin() || isHospAdmin(hospId) || isHospFarmaceuticoTitular(hospId);
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }

      // ── Benchmarks anónimos ──────────────────────────────
      // write: NUNCA desde cliente — solo Cloud Functions (Admin SDK)
      match /benchmarks/{month} {
        allow read:  if isSuperAdmin() || isHospMember(hospId);
        allow write: if false;
      }

      // ── Clústeres de resistencia ─────────────────────────
      // write: NUNCA desde cliente — solo Cloud Functions (Admin SDK)
      match /resistance_clusters/{clusterId} {
        allow read:  if isSuperAdmin() || isHospMember(hospId);
        allow write: if false;
      }

      // ── Uso de voz (Whisper) ─────────────────────────────
      // write: NUNCA desde cliente — solo Cloud Functions (Admin SDK)
      match /voice_usage/{month} {
        allow read:  if isSuperAdmin() || isHospAdmin(hospId);
        allow write: if false;
      }

      // ── Cola LIS ─────────────────────────────────────────
      match /lis_queue/{queueId} {
        allow read, write: if isSuperAdmin() || isHospAdmin(hospId) || isHospPROA(hospId);
      }

      // ── EHR / FHIR ───────────────────────────────────────
      match /ehr_config/{docId} {
        allow read:  if isSuperAdmin() || isHospAdmin(hospId);
        allow write: if isSuperAdmin() || isHospAdmin(hospId);
      }
      match /ehr_requests/{reqId} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }
      match /ehr_sync_log/{logId} {
        allow read:  if isSuperAdmin() || isHospAdmin(hospId);
        allow write: if false;
      }

      // ── Módulo Clínica / Expediente Electrónico ──────────
      match /clinica_patients/{clinicaPacId} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }
      match /clinica_patients/{clinicaPacId}/{subCol}/{subDocId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin()
                      || (isHospMember(hospId) && !resource.data.get('firmado', false));
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }
      match /clinica_appointments/{apptId} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }

      // ── Contactos, profilaxis, certificaciones, alertas ──
      match /contacts/{id}          { allow read, write: if isSuperAdmin() || isHospMember(hospId); }
      match /profilaxis/{id}        { allow read, write: if isSuperAdmin() || isHospMember(hospId); }
      match /certificaciones/{id}   { allow read, write: if isSuperAdmin() || isHospMember(hospId); }
      match /alertas_atendidas/{id} { allow read, write: if isSuperAdmin() || isHospMember(hospId); }

      // ── Solicitudes de cultivo ────────────────────────────
      match /culture_requests/{reqId} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }

      // ── Catch-all para colecciones futuras del hospital ──
      // Solo lectura/escritura para miembros del MISMO hospital.
      // Subcollections de 2 niveles están cubiertas aquí.
      match /{anyCol}/{anyDoc} {
        allow read, write: if isSuperAdmin() || isHospMember(hospId);
      }
      // Subcollections de 3 niveles (safety net)
      match /{anyCol}/{anyDoc}/{subCol}/{subDocId} {
        allow read:   if isSuperAdmin() || isHospMember(hospId);
        allow create: if isSuperAdmin() || isHospMember(hospId);
        allow update: if isSuperAdmin() || isHospMember(hospId);
        allow delete: if isSuperAdmin() || isHospAdmin(hospId);
      }

    } // end hospitals/{hospId}

    // ══════════════════════════════════════════════════════
    //  SOLICITUDES DE DEMO — formulario público sin login
    //  Cualquiera puede crear (formulario del login).
    //  Solo el super-admin puede leer, actualizar y borrar.
    // ══════════════════════════════════════════════════════
    match /solicitudes_demo/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // ── Tickets de soporte (v277) — usuario autenticado reporta; solo super-admin gestiona ──
    match /soporte_tickets/{docId} {
      allow create: if isAuth();
      allow read, update, delete: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════
    //  DENEGACIÓN GLOBAL POR DEFECTO
    //  Cualquier colección no listada arriba queda cerrada.
    // ══════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
