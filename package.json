{
  "name": "stewardmx",
  "version": "1.0.0",
  "private": true,
  "description": "StewardMX — PWA hospitalaria de PROA/AMS (vanilla JS + Firebase).",
  "type": "module",
  "scripts": {
    "test": "node --test tests/critical-flows.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-stewardmx --only firestore \"node --test tests/firestore-rules.test.mjs\"",
    "test:emu": "firebase emulators:exec --project demo-stewardmx --only firestore,functions,auth \"node --test tests/firestore-rules.test.mjs && node --test tests/functions.test.mjs\"",
    "check": "node tests/check-syntax.mjs",
    "mantenimiento": "node scripts/mantenimiento.mjs",
    "predeploy": "npm run check && npm test",
    "deploy:staging": "firebase hosting:channel:deploy staging --expires 30d",
    "deploy:prod": "firebase deploy --only hosting"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.0",
    "firebase-tools": "^13.0.0"
  }
}
